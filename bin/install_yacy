#!/usr/bin/env ruby
# install_yacy

# 20261121
# 0.6.0

lib_dir = File.expand_path(File.join('..', '..', 'lib'), __FILE__)
$LOAD_PATH.unshift(lib_dir) unless $LOAD_PATH.include?(lib_dir)

def macos?
  RUBY_PLATFORM.include?('darwin')
end

def linux?
  RUBY_PLATFORM.include?('linux')
end

def platform
  @platform ||= (
    if macos?
      require 'InstallYaCy/MacOS'
      InstallYaCy::MacOS
    elsif linux?
      require 'InstallYaCy/Linux'
      Linux::PackageManager.verbose = true
      Tarball.verbose = true
      InstallYaCy::Linux
    else
      abort("install_yacy installs YaCy on macOS and Linux only.")
    end
  )
end

def main
  platform.put_homebrew_on_path if platform.homebrew_installed_but_not_on_path?
  platform.install_java unless platform.java_installed?
  platform.install_yacy unless platform.yacy_installed?
  platform.start_yacy
end

main
