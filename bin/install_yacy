#!/usr/bin/env ruby
# install_yacy

# 20200616
# 0.2.1

# Changes:
# -/0: Homebrew installation stuff
# 1. + require 'FileUtils/which'
# 2. + require 'Kernel/run'
# 3. + homebrew_installed?()
# 4. + install_homebrew()
# 5. + yacy_installed?()
# 6. ~ main(): yacy_installed?
# 0/1: Local lib and Gem dependencies
# 7. + ./lib/
# 8. + ./Gemfile
# 9. /require 'nokogiri'/require_nokogiri/
# 10. + require_nokogiri
# 11. + lib_dir

lib_dir = File.expand_path(File.join('..', '..', 'lib'), __FILE__)
$LOAD_PATH.unshift(lib_dir) unless $LOAD_PATH.include?(lib_dir)

def require_nokogiri
  require 'nokogiri'
rescue
  run('gem install nokogiri', show: true)
end

require 'fileutils'
require 'FileUtils/which'
require 'Kernel/run'
require 'MacOS/Dmg'
require_nokogiri
require 'open-uri'

def yacy_installed?
  File.exist?("/Users/#{current_user}/Applications/YaCy.app") ||
    File.exist?("/Users/Applications/YaCy.app")
end

def homebrew_installed?
  FileUtils.which('brew')
end

def install_homebrew
  run('/usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"', show: true)
end

def link_openjdk
  run('sudo ln -sfn /usr/local/opt/openjdk/libexec/openjdk.jdk /Library/Java/JavaVirtualMachines/openjdk.jdk', show: true)
end

def install_openjdk
  run('brew install openjdk', show: true)
  link_openjdk
end

def latest_macos_yacy
  doc = Nokogiri.HTML(URI.open('http://latest.yacy.net'))
  doc.search('a').map{|e| e[:href]}.reverse.detect{|e| e =~ /\.dmg/}
end

def current_user
  ENV['USER']
end

def download(url)
  filename = File.basename(url)
  File.open(filename, 'wb') do |file|
    file.write(URI.open(url).read)
  end
end

def download_yacy
  Dir.chdir("/Users/#{current_user}/Downloads")
  download("http://latest.yacy.net/#{latest_macos_yacy}")
end

def mount_yacy_image
  dmg_filename = "/Users/#{current_user}/Downloads/yacy_v1.922_20191013_9964.dmg"
  MacOS::Dmg.mount(dmg_filename)
end

def copy_yacy_to_applications_dir
  if Dir.exist?("/Users/#{current_user}/Applications")
    FileUtils.cp_r('/Volumes/YaCy/YaCy.app', "/Users/#{current_user}/Applications")
  else
    FileUtils.cp_r('/Volumes/YaCy/YaCy.app', '/Applications')
  end
end

def install_yacy
  download_yacy
  mount_yacy_image
  copy_yacy_to_applications_dir
end

# This also performs the equivalent of `open http://localhost:8090`.
def start_yacy
  run("open -a 'YaCy'", show: true)
end

def main
  unless yacy_installed?
    install_homebrew unless homebrew_installed?
    install_openjdk
    install_yacy
  end
  start_yacy
end

main
